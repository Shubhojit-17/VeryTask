# ============================================================
# VeryTask Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================

# ============================================================
# Blockchain Configuration - Very Chain
# ============================================================

# Your deployer wallet private key (WITHOUT 0x prefix)
# WARNING: Keep this secret! Use a dedicated deployer wallet.
PRIVATE_KEY=your_private_key_here

# Very Chain Mainnet (Chain ID: 4613)
# RPC URL: https://rpc.verylabs.io
# Block Explorer: https://www.veryscan.io
VERYSCAN_API_KEY=your_veryscan_api_key_here

# ============================================================
# Supabase Configuration
# ============================================================

# Your Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public - safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (SECRET - server-side only!)
# WARNING: Never expose this to the client!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# Wepin Wallet Configuration
# ============================================================

# Get these from the Wepin Developer Dashboard
# https://developer.wepin.io
NEXT_PUBLIC_WEPIN_APP_ID=your_wepin_app_id
NEXT_PUBLIC_WEPIN_APP_KEY=your_wepin_app_key

# ============================================================
# IPFS Configuration (for proof storage)
# ============================================================

# Pinata (recommended for hackathons)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Or Web3.Storage
WEB3_STORAGE_TOKEN=your_web3_storage_token

# ============================================================
# Application Configuration
# ============================================================

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gas Reporter (for testing)
REPORT_GAS=false

# ============================================================
# Deployed Contract Addresses (fill after deployment)
# Run: npx hardhat run scripts/deploy.ts --network very_mainnet
# ============================================================

NEXT_PUBLIC_TASK_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_USER_REPUTATION_ADDRESS=
NEXT_PUBLIC_MOCK_AD_VERY_ADDRESS=
